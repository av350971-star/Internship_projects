# ==============================================================================
# LLM Playground - Environment Configuration
# ==============================================================================
# Enter your LLM Provider details below.
# This works with ANY OpenAI-compatible provider:
# - OpenAI: https://api.openai.com/v1
# - Groq: https://api.groq.com/openai/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Ollama (Local): http://localhost:11434/v1
# - DeepSeek: https://api.deepseek.com/v1
# - Together AI: https://api.together.xyz/v1
# ==============================================================================

# LLM Base URL (defaults to standard OpenAI endpoint)
LLM_BASE_URL=https://api.openai.com/v1

# Your API Key (Paste your key here)
LLM_API_KEY=your_api_key_here

# Default Model to select on load
DEFAULT_MODEL=gpt-4o-mini

# Default Temperature (0.0 to 2.0)
DEFAULT_TEMPERATURE=0.7

# Server Host & Port
PORT=8000
HOST=127.0.0.1
